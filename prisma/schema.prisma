// Prisma 7 · PostgreSQL (parte transaccional del Caso 8: Cursos en línea)
// La URL de conexión vive en prisma7.config.ts (datasource.url), no aquí.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

model User {
  id         Int         @id @default(autoincrement())
  name       String
  email      String      @unique
  password   String
  role       Role
  matriculas Matricula[]
}

model Matricula {
  id             Int      @id @default(autoincrement())
  user           User     @relation(fields: [userId], references: [id])
  userId         Int
  // _id del Curso en MongoDB (24 caracteres hex). Sin FK: la valida el servicio.
  cursoId        String?
  montoPagado    Decimal  @db.Decimal(10, 2)
  metodoPago     String
  estadoPago     String   @default("PAGADO")
  fechaMatricula DateTime @default(now())

  @@unique([userId, cursoId])
  @@index([cursoId])
}
