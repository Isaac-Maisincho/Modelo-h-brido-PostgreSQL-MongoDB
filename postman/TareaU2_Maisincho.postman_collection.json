              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"PUT responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"save() ejecuta el pre('validate'): título normalizado y módulos numerados\", () => {",
                  "  const c = pm.response.json();",
                  "  pm.expect(c.titulo).to.eql(\"Backend con Node.js avanzado \" + pm.collectionVariables.get(\"runTag\"));",
                  "  pm.expect(c.precio).to.eql(150);",
                  "  pm.expect(c.modulos.map(m => m.orden)).to.eql([1, 2, 3, 4]);",
                  "  pm.expect(c.duracionTotalMinutos).to.eql(210);",
                  "});"
                ]
