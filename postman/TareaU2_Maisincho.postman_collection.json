    {
      "name": "2. Catálogo de cursos (MongoDB)",
      "item": [
        {
          "name": "Crear curso (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Crear curso responde 201\", () => pm.response.to.have.status(201));",
                  "const curso = pm.response.json();",
                  "pm.collectionVariables.set(\"cursoId\", curso._id);",
                  "pm.test(\"El hook pre('validate') numera los módulos y el virtual suma la duración\", () => {",
                  "  pm.expect(curso.modulos.map(m => m.orden)).to.eql([1, 2, 3]);",
                  "  pm.expect(curso.duracionTotalMinutos).to.eql(180);",
                  "  pm.expect(curso.codigo).to.eql(pm.collectionVariables.get(\"cursoCodigo\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cursos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cursos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": \"{{cursoCodigo}}\",\n  \"titulo\": \"Backend con Node.js y Express {{runTag}}\",\n  \"descripcion\": \"Curso práctico de APIs REST con Express, Prisma y Mongoose.\",\n  \"nivel\": \"INTERMEDIO\",\n  \"precio\": 120,\n  \"instructor\": \"Ing. Paulo Galarza\",\n  \"modulos\": [\n    { \"titulo\": \"Introducción a Express\", \"duracionMinutos\": 45 },\n    { \"titulo\": \"Prisma 7 y PostgreSQL\", \"duracionMinutos\": 60 },\n    { \"titulo\": \"Mongoose y MongoDB\", \"duracionMinutos\": 75 }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
