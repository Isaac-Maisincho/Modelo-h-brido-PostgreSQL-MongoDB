    "name": "TareaU2 · Caso 8 Cursos en línea · Maisincho",
    "description": "Modelo híbrido PostgreSQL + MongoDB. Ejecutar completa con Collection Runner, en orden. Es repetible: cada corrida usa un código de curso nuevo y al final borra la matrícula y el curso. Requiere `node prisma/seed.js` (usuarios admin@cursos.com y estudiante@cursos.com).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "Login administrador",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Datos únicos por ejecución: la colección se puede correr varias veces seguidas",
                  "const n = Math.floor(1000 + Math.random() * 9000);",
                  "pm.collectionVariables.set(\"cursoCodigo\", \"CRS-\" + n);",
                  "pm.collectionVariables.set(\"runTag\", \"RUN\" + n);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login admin responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Login admin devuelve un token JWT\", () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.token).to.be.a(\"string\").and.not.empty;",
                  "  pm.collectionVariables.set(\"adminToken\", json.token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login estudiante",
          "event": [
            {
