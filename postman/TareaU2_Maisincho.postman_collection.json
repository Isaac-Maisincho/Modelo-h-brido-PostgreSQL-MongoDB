              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Curso inválido responde 400 con mensajes en español\", () => {",
                  "  pm.response.to.have.status(400);",
                  "  const json = pm.response.json();",
                  "  const campos = json.errors.map(e => e.campo);",
                  "  pm.expect(campos).to.include.members([\"codigo\", \"titulo\", \"nivel\", \"precio\", \"modulos\"]);",
                  "});"
                ]
              }
            }
          ],
