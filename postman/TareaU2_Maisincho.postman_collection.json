        {
          "name": "Buscar cursos ?q= &fields= &sort=",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Búsqueda responde 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"?q= encuentra el curso creado (regex insensible a mayúsculas)\", () => {",
                  "  const ids = json.data.map(c => c._id);",
                  "  pm.expect(ids).to.include(pm.collectionVariables.get(\"cursoId\"));",
                  "});",
                  "pm.test(\"?fields= proyecta solo titulo, nivel y precio\", () => {",
                  "  const c = json.data[0];",
                  "  pm.expect(c).to.have.property(\"titulo\");",
                  "  pm.expect(c).to.have.property(\"precio\");",
                  "  pm.expect(c).to.not.have.property(\"descripcion\");",
                  "  pm.expect(c).to.not.have.property(\"instructor\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cursos?q={{runTag}}&fields=titulo,nivel,precio&sort=precio",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cursos"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "{{runTag}}"
                },
                {
                  "key": "fields",
                  "value": "titulo,nivel,precio"
                },
                {
                  "key": "sort",
                  "value": "precio"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Buscar en minúsculas y ordenar ?sort=-createdAt",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set(\"runTagLower\", pm.collectionVariables.get(\"runTag\").toLowerCase());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"?sort=-createdAt devuelve fechas en orden descendente\", () => {",
                  "  pm.response.to.have.status(200);",
                  "  const fechas = pm.response.json().data.map(c => new Date(c.createdAt).getTime());",
                  "  const ordenadas = [...fechas].sort((a, b) => b - a);",
                  "  pm.expect(fechas).to.eql(ordenadas);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cursos?q={{runTagLower}}&sort=-createdAt",
              "host": [
