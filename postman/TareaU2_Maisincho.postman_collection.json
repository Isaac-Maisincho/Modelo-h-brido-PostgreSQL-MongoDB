            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/comentarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "comentarios"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"matriculaId\": {{matriculaId}},\n  \"calificacion\": 1,\n  \"contenido\": \"No debería poder comentar esto.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Listar comentarios con populate (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Listado de comentarios responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"populate trae codigo, titulo y nivel del curso; orden descendente\", () => {",
                  "  const data = pm.response.json().data;",
                  "  const c = data.find(x => x.matriculaId === Number(pm.collectionVariables.get(\"matriculaId\")));",
                  "  pm.expect(c).to.exist;",
                  "  pm.expect(c.cursoId.codigo).to.eql(pm.collectionVariables.get(\"cursoCodigo\"));",
                  "  pm.expect(c.cursoId).to.have.property(\"nivel\");",
                  "  const fechas = data.map(x => new Date(x.createdAt).getTime());",
                  "  pm.expect(fechas).to.eql([...fechas].sort((a, b) => b - a));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/comentarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "comentarios"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Resumen por curso con aggregate (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Resumen responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"aggregate devuelve promedio y total del curso\", () => {",
                  "  const fila = pm.response.json().data.find(r => r.cursoId === pm.collectionVariables.get(\"cursoId\"));",
                  "  pm.expect(fila).to.exist;",
                  "  pm.expect(fila.totalComentarios).to.eql(1);",
                  "  pm.expect(fila.promedioCalificacion).to.eql(5);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/comentarios/resumen",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "comentarios",
                "resumen"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
